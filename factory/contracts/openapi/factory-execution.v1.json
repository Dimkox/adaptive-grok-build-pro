  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "AdvanceExecutionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant",
          "packet_digest",
          "stage"
        ],
        "properties": {
          "grant": {
            "$ref": "#/components/schemas/LeaseGrant"
          },
          "packet_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "stage": {
            "enum": [
              "running",
              "collecting"
            ]
          }
        }
      },
      "ArtifactRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant",
          "packet_digest",
          "sequence",
          "artifact_class",
          "path",
          "sha256",
          "size_bytes",
          "media_type"
        ],
        "properties": {
          "grant": {
            "$ref": "#/components/schemas/LeaseGrant"
          },
          "packet_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          },
          "artifact_class": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "CapabilityPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allowed_paths",
          "allowed_tools",
          "network_destinations",
          "artifact_classes",
          "environment_names"
        ],
        "properties": {
          "allowed_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "allowed_tools": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 128,
            "uniqueItems": true
          },
          "network_destinations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "maxItems": 32,
            "uniqueItems": true
          },
          "artifact_classes": {
            "type": "array",
            "items": {
