{
  "openapi": "3.1.0",
  "info": {
    "title": "Adaptive Factory Result Admission API",
    "version": "1.0.0",
    "description": "Authenticated immutable result admission with a dormant durable outbox. No channel is qualified in 04A, so admission never enqueues; model transport and qualification-gated enqueue are outside this contract."
  },
