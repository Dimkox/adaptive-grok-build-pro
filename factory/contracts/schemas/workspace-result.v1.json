{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-grok.invalid/factory/workspace-result.v1.json",
  "title": "Adaptive Factory WorkspaceResultV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "task_id", "run_id", "task_packet_digest", "run_manifest_digest",
    "exact_head_sha", "workspace_snapshot_digest", "terminal_stage", "terminal_proposal_digest",
    "artifact_manifest_digest", "note_manifest_digest", "usage_evidence_digest",
    "diagnostics_digest", "m4_status", "failure_class", "failure_reason",
    "workspace_result_digest"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "task_packet_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workspace_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_stage": {"enum": ["completed", "failed", "needs_human"]},
    "terminal_proposal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "note_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usage_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diagnostics_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "m4_status": {"enum": ["ready_for_human", "retry", "needs_human", "dead"]},
    "failure_class": {
      "type": ["string", "null"],
      "enum": [
        null, "database_unavailable", "worker_lost", "provider_transport_unavailable",
        "temporary_resource_exhaustion", "validation", "policy", "authentication",
        "unsupported_capability", "budget", "security", "stale_input", "protocol",
        "provider_quality"
      ]
    },
    "failure_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
    "workspace_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"terminal_stage": {"const": "completed"}}},
      "then": {
        "properties": {
          "m4_status": {"const": "ready_for_human"},
          "failure_class": {"const": null},
          "failure_reason": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"terminal_stage": {"const": "failed"}}},
      "then": {
        "properties": {
          "m4_status": {"enum": ["retry", "needs_human", "dead"]},
          "failure_class": {"type": "string"},
          "failure_reason": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    },
    {
      "if": {"properties": {"terminal_stage": {"const": "needs_human"}}},
      "then": {
        "properties": {
          "m4_status": {"const": "needs_human"},
          "failure_class": {"const": null},
          "failure_reason": {"type": "string", "minLength": 1, "maxLength": 4096}
        }
      }
    }
  ]
}
