{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:prediction-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prediction_id",
    "repository_id",
    "change_id",
    "candidate_sha",
    "feature_schema_digest",
    "dataset_digest",
    "split_digest",
    "model_digest",
    "preprocessing_digest",
    "seed",
    "predicted_at",
    "first_check_started_at",
    "train_before",
    "test_after",
    "train_change_ids",
    "test_change_ids",
    "features",
    "required_history_count",
    "observed_history_count",
    "label_status",
    "predicted_value",
    "output_space"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "prediction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "change_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidate_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "feature_schema_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "split_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "preprocessing_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "predicted_at": {
      "type": "string",
      "format": "date-time"
    },
    "first_check_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "train_before": {
      "type": "string",
      "format": "date-time"
    },
    "test_after": {
      "type": "string",
      "format": "date-time"
    },
    "train_change_ids": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "test_change_ids": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "features": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "observed_at"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "value": {
            "type": "number"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "required_history_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "observed_history_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "label_status": {
      "enum": [
        "unknown",
        "product_failure",
        "product_pass",
        "infrastructure_abort",
        "pending"
      ]
    },
    "predicted_value": {
      "type": [
        "number",
        "null"
      ]
    },
    "output_space": {
      "enum": [
        "probability",
        "log_odds"
      ]
    }
  }
}
