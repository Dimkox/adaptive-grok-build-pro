{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:landing-attempt:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_digest", "spec_digest", "profile_digest", "ordinal", "exact_base_sha", "exact_head_sha", "workspace_result_digest", "renderer_digest", "writer_id", "context_digest", "evaluator_digest", "prior_attempt_digest", "outcome", "started_at", "completed_at", "attempt_digest"],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "properties": {
    "schema_version": {"const": 1},
    "input_digest": {"$ref": "#/$defs/digest"},
    "spec_digest": {"$ref": "#/$defs/digest"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 3},
    "exact_base_sha": {"$ref": "#/$defs/sha"},
    "exact_head_sha": {"$ref": "#/$defs/sha"},
    "workspace_result_digest": {"$ref": "#/$defs/digest"},
    "renderer_digest": {"$ref": "#/$defs/digest"},
    "writer_id": {"$ref": "#/$defs/id"},
    "context_digest": {"$ref": "#/$defs/digest"},
    "evaluator_digest": {"$ref": "#/$defs/digest"},
    "prior_attempt_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "outcome": {"enum": ["candidate", "repair", "needs_human"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "attempt_digest": {"$ref": "#/$defs/digest"}
  }
}
