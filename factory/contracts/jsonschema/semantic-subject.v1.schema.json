{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:semantic-subject:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","subject_id","requirements","exact_base_sha","exact_head_sha","spec_digest","architecture_digest","authority_digest","diff_digest","deterministic_evidence_digest","holdout_evidence_digest","review_evidence_digest","original_writer_id","original_writer_context_digest","risk_level","diff_lines","diff_limit"],
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "requirement": {"type":"object","additionalProperties":false,"required":["kind","requirement_id"],"properties":{"kind":{"enum":["acceptance_criterion","invariant","forbidden_outcome","architecture_rule","non_functional_requirement"]},"requirement_id":{"$ref":"#/$defs/id"}}}
  },
  "properties": {
    "schema_version":{"const":1}, "subject_id":{"$ref":"#/$defs/id"},
    "requirements":{"type":"array","minItems":1,"maxItems":256,"uniqueItems":true,"items":{"$ref":"#/$defs/requirement"}},
    "exact_base_sha":{"$ref":"#/$defs/sha"}, "exact_head_sha":{"$ref":"#/$defs/sha"},
    "spec_digest":{"$ref":"#/$defs/digest"}, "architecture_digest":{"$ref":"#/$defs/digest"}, "authority_digest":{"$ref":"#/$defs/digest"}, "diff_digest":{"$ref":"#/$defs/digest"},
    "deterministic_evidence_digest":{"$ref":"#/$defs/digest"}, "holdout_evidence_digest":{"$ref":"#/$defs/digest"}, "review_evidence_digest":{"$ref":"#/$defs/digest"},
    "original_writer_id":{"$ref":"#/$defs/id"}, "original_writer_context_digest":{"$ref":"#/$defs/digest"},
    "risk_level":{"enum":["low","medium","high","critical"]}, "diff_lines":{"type":"integer","minimum":0,"maximum":1000000}, "diff_limit":{"type":"integer","minimum":1,"maximum":1000000}
  }
}
