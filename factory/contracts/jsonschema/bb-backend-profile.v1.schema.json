{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:bb-backend-profile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "enabled",
    "source_commit",
    "binary_digest",
    "workflows_digest",
    "orchestra_digest",
    "capabilities",
    "max_agents",
    "max_depth",
    "max_cost_usd_micros",
    "wall_seconds",
    "lease_seconds",
    "stop_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "enabled": {
      "const": false
    },
    "source_commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "binary_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflows_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "orchestra_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "observe",
          "pause",
          "resume",
          "cancel",
          "pre_model_interception"
        ]
      }
    },
    "max_agents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "max_depth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "max_cost_usd_micros": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "wall_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "lease_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "stop_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    }
  }
}
