{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:context-manifest:v1",
  "x-admission": {
    "level": "structural",
    "semantic_validator": "adaptive_factory.context_contracts.ContextManifestV1.from_dict",
    "semantic_validation_required": true,
    "semantic_checks": ["utf8_byte_limits", "secret_detection", "content_digest", "source_binding", "safe_path"]
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_path": {
      "type": "string", "minLength": 1, "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\:])(?!.*(?:^|/)(?:\\.[Ee][Nn][Vv][^/]*|[Ss][Ee][Cc][Rr][Ee][Tt][Ss]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll][Ss]|\\.[Ss][Ss][Hh]|\\.[Aa][Ww][Ss]|\\.[Gg][Nn][Uu][Pp][Gg])(?:/|$))(?!.*\\.(?:[Pp][Ee][Mm]|[Kk][Ee][Yy]|[Pp]12|[Pp][Ff][Xx])$).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "content", "sha256", "reason", "applicable_scope", "mode"],
      "properties": {
        "path": {"$ref": "#/$defs/safe_path"},
        "kind": {"enum": ["instruction", "rule", "contract", "source", "navigation"]},
        "content": {
          "type": "string", "minLength": 1, "maxLength": 4096
        },
        "sha256": {"$ref": "#/$defs/digest"},
        "reason": {"$ref": "#/$defs/identifier"},
        "applicable_scope": {"$ref": "#/$defs/identifier"},
        "mode": {"enum": ["full", "verified_extract"]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "builder_version", "tenant_id", "repository_id", "source_snapshot", "change_id", "route_id", "change_spec_digest", "observed_at", "mandatory_sources", "selected_sources", "rule_bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "builder_version": {"$ref": "#/$defs/identifier"},
    "tenant_id": {"$ref": "#/$defs/identifier"},
    "repository_id": {"$ref": "#/$defs/identifier"},
    "source_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["base_sha", "head_sha", "dirty_fingerprint"],
      "properties": {
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty_fingerprint": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      }
    },
    "change_id": {"$ref": "#/$defs/identifier"},
    "route_id": {"$ref": "#/$defs/identifier"},
    "change_spec_digest": {"$ref": "#/$defs/digest"},
    "observed_at": {"type": "string", "format": "date-time"},
    "mandatory_sources": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/source"}},
    "selected_sources": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/source"}},
    "rule_bindings": {
      "type": "array", "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "rule_id", "revision", "repository_id", "source_digest", "source_path", "applicable_scope", "mode", "status"],
        "properties": {
          "criterion_id": {"$ref": "#/$defs/identifier"},
          "rule_id": {"$ref": "#/$defs/identifier"},
          "revision": {"$ref": "#/$defs/identifier"},
          "repository_id": {"$ref": "#/$defs/identifier"},
          "source_digest": {"$ref": "#/$defs/digest"},
          "source_path": {"$ref": "#/$defs/safe_path"},
          "applicable_scope": {"$ref": "#/$defs/identifier"},
          "mode": {"enum": ["full", "verified_extract"]},
          "status": {"const": "active"}
        }
      }
    }
  }
}
