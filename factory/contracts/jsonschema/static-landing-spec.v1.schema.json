{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:static-landing-spec:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_digest", "site_id", "canonical_origin", "locale", "direction", "title", "description", "robots_policy", "sections", "assets", "source_claim_refs", "spec_digest"],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_text": {"type": "string", "maxLength": 2048, "pattern": "^[^<>]*$"},
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "heading", "body", "items", "cta_label", "cta_path"],
      "properties": {
        "kind": {"enum": ["hero", "proof", "features", "workflow", "faq", "cta", "footer", "roadmap"]},
        "heading": {"$ref": "#/$defs/safe_text"},
        "body": {"$ref": "#/$defs/safe_text"},
        "items": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/safe_text"}},
        "cta_label": {"type": "string", "maxLength": 128, "pattern": "^[^<>]*$"},
        "cta_path": {"type": "string", "maxLength": 256, "pattern": "^(|/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^<>]*)$"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "alt_text", "sha256", "rights_ref"],
      "properties": {
        "path": {"type": "string", "maxLength": 256, "pattern": "^assets/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "media_type": {"enum": ["image/png", "image/jpeg", "image/webp"]},
        "alt_text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^<>]*$"},
        "sha256": {"$ref": "#/$defs/digest"},
        "rights_ref": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": 1},
    "input_digest": {"$ref": "#/$defs/digest"},
    "site_id": {"const": "therealaidarkfactory.online"},
    "canonical_origin": {"const": "https://therealaidarkfactory.online/"},
    "locale": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "direction": {"enum": ["ltr", "rtl"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 70, "pattern": "^[^<>]*$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^<>]*$"},
    "robots_policy": {"const": "preserve_source"},
    "sections": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/section"}},
    "assets": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/asset"}},
    "source_claim_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$"}},
    "spec_digest": {"$ref": "#/$defs/digest"}
  }
}
