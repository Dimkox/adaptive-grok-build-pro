{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:semantic-execution-binding:v1",
  "title": "SemanticExecutionBindingV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "run_id",
    "owner",
    "fence",
    "role",
    "repository_id",
    "workspace_handle",
    "legacy_intent_digest",
    "task_packet_digest",
    "run_manifest_digest",
    "workspace_result_digest",
    "workspace_snapshot_digest",
    "terminal_proposal_digest",
    "artifact_manifest_digest",
    "note_manifest_digest",
    "usage_evidence_digest",
    "diagnostics_digest",
    "exact_base_sha",
    "input_head_sha",
    "exact_head_sha",
    "terminal_stage",
    "m4_status",
    "failure_class",
    "failure_reason",
    "artifact_proposal_digests",
    "artifact_attestation_digests"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "owner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "fence": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "role": {"const": "writer"},
    "repository_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "workspace_handle": {"type": "string", "pattern": "^workspace:[0-9a-f]{64}$"},
    "legacy_intent_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_packet_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_result_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workspace_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "terminal_proposal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "note_manifest_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "usage_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diagnostics_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exact_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "exact_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "terminal_stage": {"const": "completed"},
    "m4_status": {"const": "ready_for_human"},
    "failure_class": {"type": "null"},
    "failure_reason": {"type": "null"},
    "artifact_proposal_digests": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "artifact_attestation_digests": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
