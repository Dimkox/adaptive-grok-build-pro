{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:m8:earned-autonomy:v2",
  "title": "Adaptive Factory M8 One-Case Cohort Evidence V2",
  "$ref": "#/$defs/cohort_evidence",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 20,
      "maxLength": 35,
      "format": "date-time"
    },
    "autonomy_tuple": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "repository_id",
        "task_class",
        "m7_change_class",
        "m7_cohort_key_digest",
        "provider_mapping_digest",
        "agent_digest",
        "validator_digest",
        "provider_digest",
        "model_digest",
        "prompt_digest",
        "policy_digest",
        "runner_digest",
        "holdout_digest",
        "authority_digest",
        "authority_ceiling",
        "expires_at"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "repository_id": {
          "$ref": "#/$defs/identifier"
        },
        "task_class": {
          "const": "low_risk_text_only"
        },
        "m7_change_class": {
          "$ref": "#/$defs/identifier"
        },
        "m7_cohort_key_digest": {
          "$ref": "#/$defs/digest"
        },
        "provider_mapping_digest": {
          "$ref": "#/$defs/digest"
        },
        "agent_digest": {
          "$ref": "#/$defs/digest"
        },
        "validator_digest": {
          "$ref": "#/$defs/digest"
        },
        "provider_digest": {
          "$ref": "#/$defs/digest"
        },
        "model_digest": {
          "$ref": "#/$defs/digest"
        },
        "prompt_digest": {
          "$ref": "#/$defs/digest"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "runner_digest": {
          "$ref": "#/$defs/digest"
        },
        "holdout_digest": {
          "$ref": "#/$defs/digest"
        },
        "authority_digest": {
          "$ref": "#/$defs/digest"
        },
        "authority_ceiling": {
          "const": "L2"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "cohort_task_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tuple_digest",
        "task_id",
        "run_id",
        "exact_head_sha",
        "observed_at",
        "m7_bundle_digest",
        "m7_outcome_digest",
        "audit_sampled",
        "audit_accepted",
        "human_acceptance_receipt_digest",
        "attestation_receipt_digest",
        "quality_score_millionths",
        "security_failure_count",
        "authorization_failure_count",
        "duplicate_dispatch_count",
        "cost_usd_micros",
        "latency_ms",
        "demotion_trigger_count"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "tuple_digest": {
          "$ref": "#/$defs/digest"
        },
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "exact_head_sha": {
          "$ref": "#/$defs/sha"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "m7_bundle_digest": {
          "$ref": "#/$defs/digest"
        },
        "m7_outcome_digest": {
          "$ref": "#/$defs/digest"
        },
        "audit_sampled": {
          "type": "boolean"
        },
        "audit_accepted": {
          "type": "boolean"
        },
        "human_acceptance_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "attestation_receipt_digest": {
          "$ref": "#/$defs/digest"
        },
        "quality_score_millionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "security_failure_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "authorization_failure_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "duplicate_dispatch_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "cost_usd_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "demotion_trigger_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "cohort_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "autonomy_tuple",
        "tasks",
        "m7_handoff",
        "window_started_at",
        "window_ended_at",
        "minimum_human_acceptances",
        "minimum_audit_rate_millionths",
        "minimum_quality_score_millionths",
        "maximum_security_failures",
        "maximum_authorization_failures",
        "maximum_duplicate_dispatches",
        "maximum_cost_usd_micros",
        "maximum_latency_ms",
        "maximum_demotion_triggers"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "autonomy_tuple": {
          "$ref": "#/$defs/autonomy_tuple"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/cohort_task_evidence"
          }
        },
        "m7_handoff": {
          "$ref": "urn:adaptive-factory:m8:m7-autonomy-bridge:v1#/$defs/handoff"
        },
        "window_started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "window_ended_at": {
          "$ref": "#/$defs/timestamp"
        },
        "minimum_human_acceptances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "minimum_audit_rate_millionths": {
          "type": "integer",
          "minimum": 200000,
          "maximum": 1000000
        },
        "minimum_quality_score_millionths": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "maximum_security_failures": {
          "const": 0
        },
        "maximum_authorization_failures": {
          "const": 0
        },
        "maximum_duplicate_dispatches": {
          "const": 0
        },
        "maximum_cost_usd_micros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "maximum_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800000
        },
        "maximum_demotion_triggers": {
          "const": 0
        }
      }
    }
  }
}
