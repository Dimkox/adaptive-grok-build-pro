# Disposable local development values only. Never copy production or Trust CI credentials here.
FACTORY_POSTGRES_DB=factory_local
FACTORY_POSTGRES_USER=factory_owner
FACTORY_POSTGRES_PASSWORD=replace-owner-for-local-use
FACTORY_POSTGRES_PORT=55432
FACTORY_MIGRATOR_DATABASE_URL=postgresql://factory_owner:replace-owner-for-local-use@127.0.0.1:55432/factory_local
FACTORY_RUNTIME_LOGIN=factory_service
FACTORY_RUNTIME_PASSWORD=replace-runtime-for-local-use
FACTORY_DATABASE_URL=postgresql://factory_service:replace-runtime-for-local-use@127.0.0.1:55432/factory_local
FACTORY_SOCKET_PATH=/run/adaptive-factory/control.sock
FACTORY_ACTORS_FILE=/run/secrets/adaptive-factory-actors.json
# Live landing executors (optional, default off). Placeholders only; never commit real keys.
FACTORY_LANDING_GROK_API_KEY=replace-grok-key-for-local-use
FACTORY_LANDING_QWEN_API_KEY=replace-qwen-key-for-local-use
# Optional live landing composition (default off). Unset provider keeps the
# shipped server on UnavailableLandingProvider. Keys are never read from a
# file named .env by the process; export them in the operator shell.
FACTORY_LANDING_PROVIDER=
FACTORY_LANDING_QUARANTINE_PATH=
FACTORY_LANDING_SOURCE_PATH=
FACTORY_LANDING_SCRATCH_PATH=
FACTORY_LANDING_OUTPUT_PATH=
