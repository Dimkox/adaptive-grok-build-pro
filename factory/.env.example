# Disposable local development values only. Never copy production or Trust CI credentials here.
FACTORY_POSTGRES_DB=factory_local
FACTORY_POSTGRES_USER=factory_local
FACTORY_POSTGRES_PASSWORD=replace-for-local-use
FACTORY_DATABASE_URL=postgresql://factory_service:replace@127.0.0.1:5432/factory_local
FACTORY_SOCKET_PATH=/run/adaptive-factory/control.sock
FACTORY_ACTORS_FILE=/run/secrets/adaptive-factory-actors.json
