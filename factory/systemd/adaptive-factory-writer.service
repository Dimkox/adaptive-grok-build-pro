[Unit]
Description=Adaptive Factory writer worker (source only)
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=adaptive-factory-writer
Group=adaptive-factory
ExecCondition=/usr/bin/false
ExecStart=/usr/bin/false
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
MemoryMax=1G
CPUQuota=100%
LimitNOFILE=1024
TasksMax=64
RuntimeMaxSec=4h
