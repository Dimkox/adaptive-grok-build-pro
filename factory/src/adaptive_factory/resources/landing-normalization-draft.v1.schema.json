{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adaptive-factory:landing-normalization-draft:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["locale", "direction", "title", "description", "sections"],
  "properties": {
    "locale": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "direction": {"enum": ["ltr", "rtl"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 70},
    "description": {"type": "string", "minLength": 1, "maxLength": 200},
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "heading", "body", "items", "cta_label", "cta_path"],
        "properties": {
          "kind": {"enum": ["hero", "proof", "features", "workflow", "faq", "cta", "footer", "roadmap"]},
          "heading": {"type": "string", "minLength": 1, "maxLength": 256},
          "body": {"type": "string", "maxLength": 2048},
          "items": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
          "cta_label": {"type": "string", "maxLength": 128},
          "cta_path": {"type": "string", "maxLength": 256}
        }
      }
    }
  }
}
