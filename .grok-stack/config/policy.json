{
  "schema_version": 3,
  "control_plane_paths": [
    ".agents/**",
    ".grok/**",
    ".grok-stack/**",
    ".github/**",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "VERSION",
    "decisions.md",
    "mistakes.md",
    "Makefile",
    "ruff.toml",
    "bandit.yaml",
    ".coveragerc",
    "scripts/grok_*.py",
    "user_prompt_submit.py",
    "pre_tool_use.py",
    "post_tool_use.py",
    "pre_compact.py",
    "session_start.py",
    "session_end.py",
    "stop_gate.py",
    "subagent_start.py",
    "subagent_stop.py",
    "docs/TRUST-BOUNDARY.md",
    "tests/test_policy.py",
    "tests/test_deploy.py",
    "tests/test_manifest_package.py",
    "tests/test_structure.py",
    "tests/test_trust_boundary.py",
    "tests/test_shell_trust_boundary.py"
  ],
  "protected_paths": [
    ".git/**",
    ".env",
    "**/.env.*",
    "**/.env",
    ".env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "bitrix/**"
  ],
  "secret_read_paths": [
    ".env",
    ".env.*",
    "**/.env.*",
    "**/.env",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/id_rsa",
    "**/id_ed25519",
    "**/credentials*",
    "**/secrets/**"
  ],
  "destructive_command_patterns": [
    "\\bgit\\s+reset\\s+--hard\\b",
    "\\bgit\\s+clean\\s+[^\\n]*(?:-f|-x)",
    "\\bgit\\s+push\\s+[^\\n]*(?:--force|-f\\b)",
    "\\bterraform\\s+(?:destroy|apply)\\b",
    "\\btofu\\s+(?:destroy|apply)\\b",
    "\\bkubectl\\s+(?:delete|apply|exec|port-forward)\\b",
    "\\bhelm\\s+(?:install|upgrade|uninstall)\\b",
    "\\bdrop\\s+(?:database|schema|table)\\b",
    "\\btruncate\\s+table\\b",
    "\\brm\\s+-rf\\s+(?:/|~|\\$HOME)\\b",
    "\\bchmod\\s+-R\\s+777\\b",
    "(?is)(?:^|[\\s;&|])(?:\\d*>>?|&>>?)\\s*[\"\\']?(?:[^\\s\"\\';&|>]+/)?(?:\\.agents(?:/|$)|\\.grok(?:/|$)|\\.grok-stack(?:/|$)|\\.github(?:/|$)|AGENTS\\.md\\b|README\\.md\\b|CHANGELOG\\.md\\b|VERSION\\b|decisions\\.md\\b|mistakes\\.md\\b|Makefile\\b|ruff\\.toml\\b|bandit\\.yaml\\b|\\.coveragerc\\b|scripts/grok_[^\\s\"\\'|;&]+\\.py\\b|(?:user_prompt_submit|pre_tool_use|post_tool_use|pre_compact|session_start|session_end|stop_gate|subagent_start|subagent_stop)\\.py\\b|docs/TRUST-BOUNDARY\\.md\\b|tests/test_(?:policy|deploy|manifest_package|structure|trust_boundary|shell_trust_boundary)\\.py\\b)",
    "(?is)(?=.*(?:\\.agents(?:/|$)|\\.grok(?:/|$)|\\.grok-stack(?:/|$)|\\.github(?:/|$)|AGENTS\\.md\\b|README\\.md\\b|CHANGELOG\\.md\\b|VERSION\\b|decisions\\.md\\b|mistakes\\.md\\b|Makefile\\b|ruff\\.toml\\b|bandit\\.yaml\\b|\\.coveragerc\\b|scripts/grok_[^\\s\"\\'|;&]+\\.py\\b|(?:user_prompt_submit|pre_tool_use|post_tool_use|pre_compact|session_start|session_end|stop_gate|subagent_start|subagent_stop)\\.py\\b|docs/TRUST-BOUNDARY\\.md\\b|tests/test_(?:policy|deploy|manifest_package|structure|trust_boundary|shell_trust_boundary)\\.py\\b))(?=.*(?:^|[;&|]\\s*|\\s)(?:rm|mv|cp|install|touch|truncate|mkdir|rmdir|ln|chmod|chown|chgrp|tee|patch)\\b)",
    "(?is)(?=.*(?:\\.agents(?:/|$)|\\.grok(?:/|$)|\\.grok-stack(?:/|$)|\\.github(?:/|$)|AGENTS\\.md\\b|README\\.md\\b|CHANGELOG\\.md\\b|VERSION\\b|decisions\\.md\\b|mistakes\\.md\\b|Makefile\\b|ruff\\.toml\\b|bandit\\.yaml\\b|\\.coveragerc\\b|scripts/grok_[^\\s\"\\'|;&]+\\.py\\b|(?:user_prompt_submit|pre_tool_use|post_tool_use|pre_compact|session_start|session_end|stop_gate|subagent_start|subagent_stop)\\.py\\b|docs/TRUST-BOUNDARY\\.md\\b|tests/test_(?:policy|deploy|manifest_package|structure|trust_boundary|shell_trust_boundary)\\.py\\b))(?=.*(?:\\bsed\\b[^\\n]*\\s-i(?:\\b|[A-Za-z])|\\bperl\\b[^\\n]*\\s-(?:[^ \\n]*i[^ \\n]*)\\b|\\b(?:python(?:3(?:\\.\\d+)?)?|node|ruby|php)\\b[^\\n]*\\s(?:-c|-e|-r)\\b|\\bgit\\b[^\\n]*\\s(?:apply|checkout|restore|rm|mv|clean)\\b|\\bruff\\b[^\\n]*--fix\\b))",
    "(?:^|[;&|]\\s*)(?!git\\s+push\\b)(?:(?:sudo|doas|command|exec|nohup|nice)\\s+)*(?:env(?:\\s+(?:-[^\\s]+|[A-Za-z_][A-Za-z0-9_]*=\\S+))*\\s+)?(?:[A-Za-z]:)?(?:[/\\\\][^\\s\"\\';&|]+)*[/\\\\]?git(?:\\s+(?:(?:-C|-c)\\s+\\S+|--(?:git-dir|work-tree|namespace)(?:=\\S+|\\s+\\S+)))*\\s+push\\b",
    "(?:^|[;&|]\\s*)(?!gh\\s+(?:pr\\s+merge|workflow\\s+run|release\\s+create)\\b)(?:(?:sudo|doas|command|exec|nohup|nice)\\s+)*(?:env(?:\\s+(?:-[^\\s]+|[A-Za-z_][A-Za-z0-9_]*=\\S+))*\\s+)?(?:[A-Za-z]:)?(?:[/\\\\][^\\s\"\\';&|]+)*[/\\\\]?gh(?:\\s+(?:(?:--repo|-R|--hostname)\\s+\\S+|--(?:repo|hostname)=\\S+))*\\s+(?:pr\\s+merge|workflow\\s+run|release\\s+create)\\b",
    "(?:^|[;&|]\\s*)(?:(?:sudo|doas|command|exec|nohup|nice)\\s+)*(?:env(?:\\s+(?:-[^\\s]+|[A-Za-z_][A-Za-z0-9_]*=\\S+))*\\s+)?(?:[A-Za-z]:)?(?:[/\\\\][^\\s\"\\';&|]+)*[/\\\\]?gh(?:\\s+(?:(?:--repo|-R|--hostname)\\s+\\S+|--(?:repo|hostname)=\\S+))*\\s+api\\b[^\\n]*(?:(?:--method|-X)\\s*(?:POST|PUT|PATCH|DELETE)\\b|(?:^|\\s)(?:-f|--field|--raw-field|--input)(?:\\s|=))",
    "(?:^|[;&|]\\s*)(?:(?:sudo|doas|command|exec|nohup|nice)\\s+)*(?:env(?:\\s+(?:-[^\\s]+|[A-Za-z_][A-Za-z0-9_]*=\\S+))*\\s+)?(?:[A-Za-z]:)?(?:[/\\\\][^\\s\"\\';&|]+)*[/\\\\]?curl\\b[^\\n]*(?:(?:-X|--request)\\s*(?:POST|PUT|PATCH|DELETE)\\b|(?:^|\\s)(?:-d|--data(?:-ascii|-binary|-raw|-urlencode)?|-F|--form|--form-string|-T|--upload-file)(?:\\s|=))",
    "(?:^|[;&|]\\s*)(?:(?:sudo|doas|command|exec|nohup|nice)\\s+)*(?:env(?:\\s+(?:-[^\\s]+|[A-Za-z_][A-Za-z0-9_]*=\\S+))*\\s+)?(?:[A-Za-z]:)?(?:[/\\\\][^\\s\"\\';&|]+)*[/\\\\]?wget\\b[^\\n]*(?:(?:--method)\\s*=?\\s*(?:POST|PUT|PATCH|DELETE)\\b|--post-(?:data|file)(?:\\s|=)|--body-(?:data|file)(?:\\s|=))"
  ],
  "notes": [
    "Control-plane writes through structured tools and common shell mutation forms are denied.",
    "Obfuscated shell code is outside the hook security boundary; protected branches, CODEOWNERS, and Environment approvals are authoritative.",
    "Production and external side effects use protected PR or Environment workflows.",
    "scripts/grok_approve.py records a request and grants no authorization.",
    "Bitrix core is protected by default. Put custom code in local/.",
    "Hooks are guardrails, not an operating-system security boundary."
  ]
}
