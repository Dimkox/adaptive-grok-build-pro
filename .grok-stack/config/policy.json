{
  "schema_version": 2,
  "protected_paths": [
    ".git/**",
    ".env",
    "**/.env.*",
    "**/.env",
    ".env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "bitrix/**",
    ".grok/**",
    ".grok-stack/**",
    ".github/**",
    "AGENTS.md",
    "scripts/grok_ci.py",
    "scripts/grok_ci_verify.py",
    "scripts/grok_approve.py",
    "scripts/grok_verify.py",
    "scripts/install_self_hosted_ci.py",
    "scripts/install_into.py",
    "scripts/package_stack.py",
    "ops/self-hosted-ci/**",
    "tests/test_ci_*.py",
    ".coveragerc",
    "ruff.toml",
    "bandit.yaml",
    "VERSION"
  ],
  "secret_read_paths": [
    ".env",
    ".env.*",
    "**/.env.*",
    "**/.env",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/id_rsa",
    "**/id_ed25519",
    "**/credentials*",
    "**/secrets/**",
    "/etc/adaptive-grok-ci/**",
    "/var/lib/adaptive-grok-ci/**"
  ],
  "notes": [
    "Local hooks are advisory and fail-open for agent availability; they are not merge authority.",
    "The root-owned self-hosted CI is the authoritative exact-SHA gate.",
    "Prompt memory files are not trusted policy. Trusted control-plane changes require an external signed approval.",
    "Bitrix core is protected by default. Put custom code in local/."
  ]
}
