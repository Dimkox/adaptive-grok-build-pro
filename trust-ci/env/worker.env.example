TRUST_CI_SIGNING_KEY_PATH=/run/secrets/trust-ci-signing-key.pem
TRUST_CI_GITHUB_APP_ID=REPLACE_WITH_APP_ID
TRUST_CI_GITHUB_INSTALLATION_ID=REPLACE_WITH_INSTALLATION_ID
TRUST_CI_GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
TRUST_CI_WORKSPACE_ROOT=/var/lib/adaptive-trust-ci/workspaces
TRUST_CI_WORKER_ID=worker-01
TRUST_CI_POLL_INTERVAL_SECONDS=2
TRUST_CI_ROLE=worker
DOCKER_GID=999
