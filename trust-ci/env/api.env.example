TRUST_CI_DATABASE_URL=postgresql://trust_ci_api:REPLACE_WITH_URLENCODED_API_PASSWORD@postgres:5432/trust_ci
TRUST_CI_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
TRUST_CI_TRUST_STORE_PATH=/etc/adaptive-trust-ci/trust-store.json
TRUST_CI_READ_TOKEN=REPLACE_WITH_LONG_RANDOM_READ_TOKEN
TRUST_CI_DEPLOYER_TOKEN=REPLACE_WITH_SEPARATE_LONG_RANDOM_DEPLOYER_TOKEN
TRUST_CI_DEPLOYER_DATABASE_URL=postgresql://trust_ci_deployer:REPLACE_WITH_URLENCODED_DEPLOYER_PASSWORD@postgres:5432/trust_ci
TRUST_CI_PROMOTION_MANIFEST_PATH=/opt/adaptive-trust-ci/supply-chain/supply-chain.manifest.json
TRUST_CI_PROMOTION_MANIFEST_SHA256=REPLACE_WITH_SIGNED_MANIFEST_SHA256
TRUST_CI_PROMOTION_ARTIFACT_PATH=/opt/adaptive-trust-ci/supply-chain/artifact.zip
TRUST_CI_PROMOTION_CONSUME_RATE_LIMIT_PER_MINUTE=60
TRUST_CI_PROTECTED_REF=refs/heads/main
TRUST_CI_ROLE=api
