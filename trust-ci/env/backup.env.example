# Read by adaptive-trust-ci-backup.service on the CI host.
TRUST_CI_BACKUP_DATABASE_URL=postgresql://trust_ci_backup:REPLACE_WITH_URLENCODED_BACKUP_PASSWORD@postgres:5432/trust_ci
TRUST_CI_BACKUP_DIR=/srv/adaptive-trust-ci/backups
TRUST_CI_BACKUP_DATABASE_LABEL=adaptive-trust-ci-primary
TRUST_CI_BACKUP_KEEP_LAST=14
TRUST_CI_BACKUP_MAX_AGE_DAYS=30
TRUST_CI_COMPOSE_DIRECTORY=/opt/adaptive-grok-build-pro/trust-ci
