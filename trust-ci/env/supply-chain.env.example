# Read by adaptive-trust-ci-compose.service on the CI host.
TRUST_CI_SUPPLY_CHAIN_DIR=/srv/adaptive-trust-ci/releases/2.1.0
COSIGN_PUBLIC_KEY=/etc/adaptive-trust-ci/cosign.pub
TRUST_CI_PROMOTION_MANIFEST_SHA256=REPLACE_WITH_SIGNED_MANIFEST_SHA256
TRUST_CI_COMPOSE_ENV_FILE=/opt/adaptive-grok-build-pro/trust-ci/.env
TRUST_CI_DEPLOY_POLICY_PATH=/opt/adaptive-grok-build-pro/trust-ci/runtime/policy.json
