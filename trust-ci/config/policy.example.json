{
  "schema_version": 1,
  "status_context": "adaptive-trust-ci/verified",
  "pipeline": "pull_request",
  "checkout_depth": 250,
  "lease_seconds": 300,
  "max_attempts": 3,
  "max_approval_ttl_seconds": 1800,
  "max_output_bytes": 200000,
  "allowed_environment": [],
  "sandbox": {
    "runtime": "docker",
    "image": "adaptive-trust-ci-runner@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "user": "10001:10001",
    "memory_mb": 4096,
    "cpus": 2.0,
    "pids_limit": 512,
    "tmpfs_mb": 1024
  },
  "approval_rules": [
    {
      "scope": "governance",
      "globs": [".grok/**", ".grok-stack/**", "AGENTS.md", "decisions.md", "mistakes.md", "Makefile", "scripts/grok_approve.py", "scripts/grok_review.py", "scripts/grok_verify.py", "trust-ci/**"]
    },
    {
      "scope": "database",
      "globs": ["**/migrations/**", "**/sql/**", "**/*.sql"]
    },
    {
      "scope": "production",
      "globs": [".github/**", "**/Dockerfile", "**/compose*.yml", "**/compose*.yaml", "**/systemd/**", "infra/**", "terraform/**"]
    }
  ],
  "repository_profiles": [
    {
      "repository": "Dimkox/adaptive-grok-build-pro",
      "commands": [
        {"name": "root-unittest", "argv": ["python3", "-m", "unittest", "discover", "-s", "tests"], "timeout_seconds": 900, "required": true},
        {"name": "trust-ci-unittest", "argv": ["python3", "-m", "unittest", "discover", "-s", "trust-ci/tests"], "timeout_seconds": 900, "required": true}
      ],
      "holdout": {
        "path": "/etc/adaptive-trust-ci/holdout/adaptive-grok-build-pro",
        "digest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "commands": [{"name": "adaptive-holdout", "argv": ["python3", "/holdout/validate.py", "/workspace"], "timeout_seconds": 300, "required": true}]
      }
    },
    {
      "repository": "Dimkox/ii-tonya-platform",
      "commands": [
        {"name": "platform-unit", "argv": ["pytest", "-q"], "timeout_seconds": 900, "required": true},
        {"name": "platform-compile", "argv": ["python3", "-m", "compileall", "-q", "."], "timeout_seconds": 300, "required": true}
      ],
      "holdout": {
        "path": "/etc/adaptive-trust-ci/holdout/ii-tonya-platform",
        "digest": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "commands": [{"name": "platform-holdout", "argv": ["python3", "/holdout/validate.py", "/workspace"], "timeout_seconds": 300, "required": true}]
      }
    }
  ]
}
