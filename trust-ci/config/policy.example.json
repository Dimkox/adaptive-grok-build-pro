{
  "schema_version": 1,
  "allowed_repositories": [
    "Dimkox/adaptive-grok-build-pro"
  ],
  "status_context": "adaptive-trust-ci/verified",
  "pipeline": "pull_request",
  "checkout_depth": 250,
  "lease_seconds": 300,
  "max_attempts": 3,
  "max_approval_ttl_seconds": 1800,
  "max_output_bytes": 200000,
  "allowed_environment": [],
  "sandbox": {
    "runtime": "docker",
    "image": "adaptive-trust-ci-runner@sha256:REPLACE_WITH_IMMUTABLE_RUNNER_DIGEST",
    "user": "10001:10001",
    "memory_mb": 4096,
    "cpus": 2.0,
    "pids_limit": 512,
    "tmpfs_mb": 1024
  },
  "commands": [
    {
      "name": "root-unittest",
      "argv": ["python3", "-m", "unittest", "discover", "-s", "tests"],
      "timeout_seconds": 900,
      "required": true
    },
    {
      "name": "trust-ci-unittest",
      "argv": ["python3", "-m", "unittest", "discover", "-s", "trust-ci/tests"],
      "timeout_seconds": 900,
      "required": true
    },
    {
      "name": "compileall",
      "argv": ["python3", "-m", "compileall", "-q", ".grok-stack/adaptive_grok", "scripts", "trust-ci/src"],
      "timeout_seconds": 300,
      "required": true
    },
    {
      "name": "repository-verification",
      "argv": ["python3", "scripts/grok_verify.py", "--mode", "pr", "--no-record", "--json"],
      "timeout_seconds": 1200,
      "required": true
    }
  ],
  "holdout": {
    "path": "/etc/adaptive-trust-ci/holdout",
    "digest": "b78d17006e270cec373aa130d7b0d11de357ffa236297b41075234e6ad7d5db8",
    "commands": [
      {
        "name": "external-holdout",
        "argv": ["python3", "/holdout/validate.py", "/workspace"],
        "timeout_seconds": 300,
        "required": true
      }
    ]
  },
  "promotion": {
    "environments": ["production"],
    "max_ttl_seconds": 900
  },
  "approval_rules": []
}
