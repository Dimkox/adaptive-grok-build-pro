[Unit]
Description=Adaptive Trust CI self-hosted control plane
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/adaptive-grok-build-pro/trust-ci
ExecStart=/usr/bin/docker compose up -d postgres migrate api worker
ExecReload=/usr/bin/docker compose up -d --build postgres migrate api worker
ExecStop=/usr/bin/docker compose stop api worker postgres
TimeoutStartSec=0
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
