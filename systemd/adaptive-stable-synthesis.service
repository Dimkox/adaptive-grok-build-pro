[Unit]
Description=Adaptive Grok local stable synthesis read-only upstream monitor
After=network-online.target

[Service]
Type=oneshot
User=adaptive-grok
Group=adaptive-grok
WorkingDirectory=/opt/adaptive-grok-build-pro
ExecStart=/usr/bin/python3 scripts/grok_stable_synthesis.py check
RuntimeMaxSec=100
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=-/opt/adaptive-grok-build-pro/.grok-stack/runtime

# Source-only example. Deliberately no [Install] section.
