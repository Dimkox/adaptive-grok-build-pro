{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:order-changed:v1",
  "title": "OrderChanged",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "occurredAt",
    "orderId"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "orderId": {
      "type": "string",
      "minLength": 1
    }
  }
}
