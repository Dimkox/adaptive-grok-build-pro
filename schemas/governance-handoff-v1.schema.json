{
  "$defs": {
    "sha256": {"maxLength": 64, "minLength": 64, "pattern": "^[0-9a-f]{64}$", "type": "string"},
    "sha40": {"maxLength": 40, "minLength": 40, "pattern": "^[0-9a-f]{40}$", "type": "string"}
  },
  "$id": "https://adaptive-grok.local/schemas/governance-handoff-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "architecture_digest": {"$ref": "#/$defs/sha256"},
    "exact_base_sha": {"$ref": "#/$defs/sha40"},
    "exact_head_sha": {"$ref": "#/$defs/sha40"},
    "governance_contract_version": {"const": 1, "type": "integer"},
    "governance_digest": {"$ref": "#/$defs/sha256"},
    "governance_evidence_digest": {"$ref": "#/$defs/sha256"}
  },
  "required": ["governance_contract_version", "governance_digest", "governance_evidence_digest", "architecture_digest", "exact_base_sha", "exact_head_sha"],
  "type": "object"
}
