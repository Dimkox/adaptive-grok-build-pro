{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:adaptive-grok:workflow-task-graph:v1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","change_id","source_manifest_digest","write_agent","review_agents","tasks","graph_digest"],
  "properties":{
    "schema_version":{"type":"integer","enum":[1]},
    "change_id":{"type":"string","minLength":3,"maxLength":128},
    "source_manifest_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "write_agent":{"type":"string","minLength":1,"maxLength":128},
    "review_agents":{"type":"array","maxItems":20,"items":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[^\\u0000-\\u001f\\u007f]+$"}},
    "tasks":{"type":"array","maxItems":500,"items":{"type":"object","additionalProperties":false,"required":["task_id","key","title","depends_on","covers","files","interfaces","red","green","source_status","enrichment_required","source_sha256"],"properties":{
      "task_id":{"type":"string","pattern":"^TASK-[0-9a-f]{12}$"},
      "key":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},
      "title":{"type":"string","minLength":1,"maxLength":256,"pattern":"^[^\\u0000-\\u001f\\u007f]+$"},
      "depends_on":{"type":"array","maxItems":100,"items":{"type":"string","pattern":"^TASK-[0-9a-f]{12}$"}},
      "covers":{"type":"array","maxItems":500,"items":{"type":"string","pattern":"^(AC|INV|FORBID)-[0-9]{3,6}$"}},
      "files":{"type":"array","maxItems":200,"items":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[^/\\\\\\u0000-\\u001f\\u007f][^\\\\\\u0000-\\u001f\\u007f]*$"}},
      "interfaces":{"type":"array","maxItems":100,"items":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[^\\u0000-\\u001f\\u007f]+$"}},
      "red":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[^\\u0000-\\u001f\\u007f]+$"}},
      "green":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[^\\u0000-\\u001f\\u007f]+$"}},
      "source_status":{"enum":["pending","in_progress","complete"]},
      "enrichment_required":{"type":"array","maxItems":5,"items":{"enum":["covers","files","green","interfaces","red"]}},
      "source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
    }}},
    "graph_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
