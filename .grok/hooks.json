{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/hooks/session_start.py || python3 session_start.py || python3 -c \"print('{}')\"",
            "commandWindows": "python .grok/hooks/session_start.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/hooks/user_prompt_submit.py || python3 user_prompt_submit.py || python3 -c \"print('{}')\"",
            "commandWindows": "python .grok/hooks/user_prompt_submit.py",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/hooks/pre_tool_use.py || python3 pre_tool_use.py || python3 -c \"print('{\\\"decision\\\":\\\"allow\\\"}')\"",
            "commandWindows": "python .grok/hooks/pre_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/hooks/post_tool_use.py || python3 post_tool_use.py || python3 -c \"print('{}')\"",
            "commandWindows": "python .grok/hooks/post_tool_use.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/hooks/pre_compact.py || python3 pre_compact.py || python3 -c \"print('{}')\"",
            "commandWindows": "python .grok/hooks/pre_compact.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/hooks/subagent_start.py || python3 subagent_start.py || python3 -c \"print('{}')\"",
            "commandWindows": "python .grok/hooks/subagent_start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/hooks/subagent_stop.py || python3 subagent_stop.py || python3 -c \"print('{}')\"",
            "commandWindows": "python .grok/hooks/subagent_stop.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/hooks/stop_gate.py || python3 stop_gate.py || python3 -c \"print('{}')\"",
            "commandWindows": "python .grok/hooks/stop_gate.py",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .grok/hooks/session_end.py || python3 session_end.py || python3 -c \"print('{}')\"",
            "commandWindows": "python .grok/hooks/session_end.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
