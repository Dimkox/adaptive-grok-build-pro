{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-grok.local/pilot/candidate-change.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "profile_digest", "issue_snapshot_digest",
    "run_id", "attempt", "provider_id", "model_id", "writer_id",
    "executable_version", "executable_sha256", "prompt_digest",
    "tool_policy_digest", "output_schema_digest", "sandbox_evidence_digest",
    "workspace_digest", "base_sha", "base_tree", "candidate_sha",
    "candidate_tree", "changed_files", "diff_sha256", "diff_bytes",
    "remote_removed", "object_storage_independent", "started_at",
    "completed_at", "outcome", "candidate_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"$ref": "#/$defs/id"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "issue_snapshot_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"$ref": "#/$defs/id"},
    "attempt": {"const": 1},
    "provider_id": {"$ref": "#/$defs/id"},
    "model_id": {"$ref": "#/$defs/id"},
    "writer_id": {"$ref": "#/$defs/id"},
    "executable_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "executable_sha256": {"$ref": "#/$defs/digest"},
    "prompt_digest": {"$ref": "#/$defs/digest"},
    "tool_policy_digest": {"$ref": "#/$defs/digest"},
    "output_schema_digest": {"$ref": "#/$defs/digest"},
    "sandbox_evidence_digest": {"$ref": "#/$defs/digest"},
    "workspace_digest": {"$ref": "#/$defs/digest"},
    "base_sha": {"$ref": "#/$defs/sha"},
    "base_tree": {"$ref": "#/$defs/sha"},
    "candidate_sha": {"$ref": "#/$defs/sha"},
    "candidate_tree": {"$ref": "#/$defs/sha"},
    "changed_files": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/changed_file"}},
    "diff_sha256": {"$ref": "#/$defs/digest"},
    "diff_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
    "remote_removed": {"const": true},
    "object_storage_independent": {"const": true},
    "started_at": {"$ref": "#/$defs/time"},
    "completed_at": {"$ref": "#/$defs/time"},
    "outcome": {"const": "candidate"},
    "candidate_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
    "changed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "blob_sha", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 240},
        "mode": {"const": "100644"},
        "blob_sha": {"$ref": "#/$defs/sha"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
