{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-grok.local/pilot/design-partner-outcome.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "profile_digest", "proposal_digest",
    "pr_number", "head_sha", "trust_ci_status", "required_check",
    "human_decision", "human_actor", "decision_at", "merge_commit_sha",
    "merge_tree", "status", "observed_at", "outcome_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"$ref": "#/$defs/id"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "proposal_digest": {"$ref": "#/$defs/digest"},
    "pr_number": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "head_sha": {"$ref": "#/$defs/sha"},
    "trust_ci_status": {"enum": ["success", "unavailable"]},
    "required_check": {"type": ["string", "null"], "maxLength": 128},
    "human_decision": {"enum": ["accepted", "pending", "rejected"]},
    "human_actor": {"type": ["string", "null"], "maxLength": 128},
    "decision_at": {"type": ["string", "null"], "maxLength": 32},
    "merge_commit_sha": {"type": ["string", "null"], "maxLength": 40},
    "merge_tree": {"type": ["string", "null"], "maxLength": 40},
    "status": {"enum": ["awaiting_human", "closed_rejected", "merge_gate_unavailable", "merged_accepted"]},
    "observed_at": {"$ref": "#/$defs/time"},
    "outcome_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}
  }
}
