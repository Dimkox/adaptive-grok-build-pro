{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-grok.local/pilot/candidate-validation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "job_id", "profile_digest", "candidate_digest",
    "candidate_sha", "candidate_tree", "test_profile_digest", "command_digest",
    "exit_code", "elapsed_ms", "stdout_sha256", "stderr_sha256",
    "pre_test_tree", "post_test_tree", "writer_id", "evaluator_id",
    "semantic_profile_digest", "acceptance_ids", "decision", "reason_codes",
    "completed_at", "validation_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"$ref": "#/$defs/id"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "candidate_digest": {"$ref": "#/$defs/digest"},
    "candidate_sha": {"$ref": "#/$defs/sha"},
    "candidate_tree": {"$ref": "#/$defs/sha"},
    "test_profile_digest": {"$ref": "#/$defs/digest"},
    "command_digest": {"$ref": "#/$defs/digest"},
    "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
    "elapsed_ms": {"type": "integer", "minimum": 0, "maximum": 900000},
    "stdout_sha256": {"$ref": "#/$defs/digest"},
    "stderr_sha256": {"$ref": "#/$defs/digest"},
    "pre_test_tree": {"$ref": "#/$defs/sha"},
    "post_test_tree": {"$ref": "#/$defs/sha"},
    "writer_id": {"$ref": "#/$defs/id"},
    "evaluator_id": {"$ref": "#/$defs/id"},
    "semantic_profile_digest": {"$ref": "#/$defs/digest"},
    "acceptance_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "decision": {"enum": ["pass", "needs_human", "rejected"]},
    "reason_codes": {"type": "array", "maxItems": 7, "uniqueItems": true, "items": {"enum": ["identity_mismatch", "semantic_non_pass", "test_failed", "test_mutation", "test_overflow", "test_timeout", "writer_evaluator_collision"]}},
    "completed_at": {"$ref": "#/$defs/time"},
    "validation_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}
  }
}
