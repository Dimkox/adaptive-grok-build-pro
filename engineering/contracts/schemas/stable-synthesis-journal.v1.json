{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-grok.local/contracts/stable-synthesis-journal.v1.json",
  "title": "Stable synthesis journal entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "recorded_at", "kind", "component_digest", "config_digest", "intent_digest", "snapshot_digest", "prior_digest", "digest"],
  "properties": {
    "sequence": {"type": "integer", "minimum": 1},
    "recorded_at": {"type": "number", "minimum": 0, "maximum": 9007199254740991},
    "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$"},
    "component_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "intent_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prior_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
