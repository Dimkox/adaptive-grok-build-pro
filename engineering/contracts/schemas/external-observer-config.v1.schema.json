{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adaptive-grok.local/contracts/external-observer-config.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "default_branch", "pull_request_number", "expected_check_name", "expected_app_id", "freshness_seconds"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "minLength": 3, "maxLength": 201, "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "default_branch": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9._/-]+$"},
    "pull_request_number": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "expected_check_name": {"type": "string", "minLength": 1, "maxLength": 200},
    "expected_app_id": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "freshness_seconds": {"type": "integer", "minimum": 60, "maximum": 86400}
  }
}
