{
  "components": {
    "schemas": {
      "CurrentAuthoritySnapshotV1": {
        "additionalProperties": false,
        "description": "Public exact-job observation, not merge permission. Re-read after expiry or authority changes; existing policy schema has no time-validity field.",
        "properties": {
          "schema_version": {"type": "integer", "enum": [1]},
          "repository": {"type": "string", "minLength": 3},
          "pr_number": {"type": "integer", "minimum": 1},
          "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "job_id": {"type": "string", "minLength": 1},
          "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "check_name": {"type": "string", "minLength": 1},
          "holdout_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "required_scopes": {
            "type": "array", "maxItems": 32, "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "approvals": {
            "type": "array", "maxItems": 32,
            "items": {
              "type": "object", "additionalProperties": false,
              "properties": {
                "scope": {"type": "string", "minLength": 1},
                "envelope_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "expires_at": {"type": "string", "format": "date-time"},
                "key_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
              },
              "required": ["scope", "envelope_digest", "expires_at", "key_id"]
            }
          },
          "trust_revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "attestation_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "observed_at": {"type": "string", "format": "date-time"},
          "valid_until": {"type": "string", "format": "date-time"}
        },
        "required": ["schema_version", "repository", "pr_number", "base_sha", "head_sha", "job_id", "policy_digest", "check_name", "holdout_digest", "required_scopes", "approvals", "trust_revision", "attestation_digest", "observed_at", "valid_until"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "githubWebhookSignature": {
        "in": "header",
        "name": "X-Hub-Signature-256",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Source-described bounded baseline for the existing Trust CI API. It is not a claim that a runtime OpenAPI endpoint is enabled.",
    "title": "Adaptive Trust CI",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/authority/{job_id}": {
      "parameters": [{
        "description": "Exact Trust CI job identifier",
        "in": "path", "name": "job_id", "required": true,
        "schema": {"type": "string", "minLength": 1}
      }],
      "get": {
        "description": "Authenticated read-only current policy, holdout, public approval trust and cryptographically verified CI attestation snapshot. Server sources are reloaded and rechecked. Validity is at most 60 seconds and each selected approval/key cutoff. Does not authorize merge or create approvals.",
        "security": [{"bearerAuth": []}],
        "responses": {
          "200": {
            "description": "Public current exact-job observation",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CurrentAuthoritySnapshotV1"}}}
          },
          "401": {
            "description": "Read bearer token required",
            "content": {"application/json": {"schema": {
              "type": "object", "additionalProperties": false,
              "properties": {"detail": {"type": "string"}}, "required": ["detail"]
            }}}
          },
          "409": {
            "description": "Stopped, missing, incomplete, stale, revoked, invalid, over-bound or unavailable authority",
            "content": {"application/json": {"schema": {
              "type": "object", "additionalProperties": false,
              "properties": {"detail": {"type": "string"}}, "required": ["detail"]
            }}}
          }
        }
      }
    },
    "/approvals": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "payload": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "signature": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "payload",
                  "signature"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Approval accepted"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Malformed envelope or unconfigured scope"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Approval verification failed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "No exact-SHA Trust CI job"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Approval replay conflict"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Global kill switch active"
          }
        },
        "security": []
      }
    },
    "/attestations/{job_id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Signed attestation envelope"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Read bearer token required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Attestation not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "parameters": [
        {
          "description": "Trust CI job identifier",
          "in": "path",
          "name": "job_id",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ]
    },
    "/health/live": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Liveness status"
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Readiness status"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Kill switch, durable state, or trust store unavailable"
          }
        },
        "security": []
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Public job projection"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Read bearer token required"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Job not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "parameters": [
        {
          "description": "Trust CI job identifier",
          "in": "path",
          "name": "job_id",
          "required": true,
          "schema": {
            "minLength": 1,
            "type": "string"
          }
        }
      ]
    },
    "/metrics": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "text/plain": {
                "schema": {
                  "description": "Prometheus text exposition is explicit but outside the bounded JSON comparator subset.",
                  "type": "string"
                }
              }
            },
            "description": "Prometheus text exposition"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Read bearer token required"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/webhooks/github": {
      "post": {
        "parameters": [
          {
            "description": "GitHub event kind consumed by the webhook parser",
            "in": "header",
            "name": "X-GitHub-Event",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "description": "Bounded pull-request projection; the separate projection contract defines consumed fields.",
                "type": "object"
              }
            },
            "application/octet-stream": {
              "schema": {
                "description": "Raw webhook bytes; pull_request events are conditionally decoded as JSON after signature verification.",
                "type": "string"
              }
            }
          },
          "description": "Optional for ignored event kinds; pull_request processing conditionally consumes a signed body.",
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Webhook accepted or ignored"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Webhook signature or event payload rejected"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Repository denied by server policy"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "detail"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Global kill switch active"
          }
        },
        "security": [
          {
            "githubWebhookSignature": []
          }
        ]
      }
    }
  }
}
