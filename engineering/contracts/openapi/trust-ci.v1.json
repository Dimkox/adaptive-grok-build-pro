{
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "type": "http"
      },
      "githubWebhookSignature": {
        "in": "header",
        "name": "X-Hub-Signature-256",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Source-described bounded baseline for the existing Trust CI API. It is not a claim that a runtime OpenAPI endpoint is enabled.",
    "title": "Adaptive Trust CI",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/approvals": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "payload": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "signature": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "payload",
                  "signature"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Approval accepted"
          }
        },
        "security": []
      }
    },
    "/attestations/{job_id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Signed attestation envelope"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/health/live": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Liveness status"
          }
        },
        "security": []
      }
    },
    "/health/ready": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Readiness status"
          }
        },
        "security": []
      }
    },
    "/jobs/{job_id}": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Public job projection"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/metrics": {
      "get": {
        "responses": {
          "200": {
            "description": "Prometheus text exposition"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/webhooks/github": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "description": "Bounded pull-request projection; the separate projection contract defines consumed fields.",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object"
                }
              }
            },
            "description": "Webhook accepted or ignored"
          }
        },
        "security": [
          {
            "githubWebhookSignature": []
          }
        ]
      }
    }
  }
}
